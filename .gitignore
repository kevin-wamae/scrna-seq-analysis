# ================================================
# Pixi
# ================================================
# pixi environments
.pixi/*
!.pixi/config.toml
pixi.lock

# ================================================
# R
# ================================================
# Generated during R sessions — never useful to track
Rplots.pdf
.Rhistory
.RData
.Rproj.user/
.RDataTmp

# ================================================
# Logs
# ================================================
# Track the logs/ folder itself but ignore everything inside
logs/*
!logs/.gitkeep

# ================================================
# 2_input
# ================================================
# Track the cellranger-matrix-counts folder structure
# but ignore actual matrix data (large binary files)
2_input/cellranger-matrix-counts/*
!2_input/cellranger-matrix-counts/.gitkeep

# ================================================
# Large data files (safety net)
# ================================================
# Catches any data files that land anywhere in the repo
*DS_Store
*.rds
*.qs2
*.csv
*.h5
*.bam
*.fastq
*.fastq.gz
*.sra
*.mtx
*.tsv.gz
*.bed
*.bw
*.jpg
*.png
*.pdf
